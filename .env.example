# Copy to .env.local and fill in. .env* is gitignored — never commit secrets.

# Neon Postgres (owner pastes these from the Neon console)
DATABASE_URL=
DIRECT_URL=

# Ed25519 signing key — output of: npm run keys:generate
LICENSE_PRIVATE_KEY=

# Admin auth — paste the ESCAPED line printed by: npm run admin:hash-password
# (bcrypt hashes contain `$`; in .env files every `$` must be written `\$` or
# Next's env loader silently mangles it and login always fails. Hosting
# platform env-var UIs take the raw, unescaped hash instead.)
ADMIN_PASSWORD_HASH=

# >= 32 random chars for signing admin session cookies, e.g.: openssl rand -base64 32
SESSION_SECRET=
